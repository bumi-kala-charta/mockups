---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import GeoCanvas from '../components/GeoCanvas.astro';
import MapExplorer from '../components/MapExplorer.astro';
import ProjectArt from '../components/ProjectArt.astro';
import Collaborators from '../components/Collaborators.astro';
import { projects, activities, values } from '../data/demo';
import '../styles/observatorium.css';
---
<SiteLayout theme="observatorium" title="Observatorium · Eksplorasi 02">
  <section class="observatory-hero wrap">
    <div class="obs-hero-top"><span class="eyebrow"><Icon name="crosshair" size={16} />Bumi Kala Charta / Geospatial collective</span><span class="eyebrow">IDN · 2026</span></div>
    <div class="obs-title-row"><h1>Setiap titik.<br /><span>Sebuah pengetahuan.</span></h1><div><p>Membaca hubungan antara bumi, data, dan kehidupan di atasnya.</p><a class="button accent" href="#peta">Buka atlas BKC<Icon name="arrow" size={18} /></a></div></div>
    <div class="obs-hero-map"><GeoCanvas hero /><div class="obs-map-tag"><span class="eyebrow">Nusantara / Ruang eksplorasi</span><span>95°–141° BT / 11° LS–6° LU</span></div><div class="obs-coordinate-card bkc-glass" data-glass="ink"><Icon name="crosshair" size={20} /><div><span class="eyebrow">Berangkat dari satu titik</span><strong>Bandung, Indonesia</strong><small>6,9175° LS · 107,6191° BT</small></div><a href="#peta" aria-label="Jelajahi peta Indonesia"><Icon name="arrow" size={22} /></a></div><span class="obs-vertical-label">PERSPEKTIF SPASIAL / WGS 84</span></div>
    <div class="obs-hero-bottom"><span><span class="status-mark"></span>06 lokasi contoh untuk dieksplorasi</span><a href="#tentang">Mengenal BKC<Icon name="down" size={15} /></a><span class="eyebrow">PROYEK / RISET / KEGIATAN</span></div>
  </section>

  <section class="wrap section obs-about" id="tentang"><span class="eyebrow">01 / Di balik koordinat</span><div class="obs-about-main"><h2>Memahami sebuah tempat.<br /><span class="soft-text">Membaca apa yang<br />terjadi di sana.</span></h2><div><p>Bumi Kala Charta mempertemukan komunitas dan praktik geospasial. Dari pengukuran di lapangan hingga percakapan tentang perubahan wilayah, kami mencari pemahaman yang bisa dibagikan.</p><a class="text-link" href="/observatorium/tentang/">Tentang Bumi Kala Charta<Icon name="arrow" size={17} /></a></div></div><div class="obs-principles">{values.map((v,i)=><div><span class="eyebrow">PRINSIP 0{i+1}</span><h3>{v.title}</h3><p>{v.description}</p></div>)}</div><span class="small-note">Rumusan prinsip merupakan eksplorasi editorial.</span></section>

  <section class="obs-practice-section" aria-labelledby="obs-practice-title"><div class="wrap"><div class="section-heading heading-split"><div><span class="eyebrow">02 / Bidang eksplorasi</span><h2 id="obs-practice-title">Pertanyaan berbeda.<br />Pendekatan yang terhubung.</h2></div><p>Geodesi dan geomatika sebagai cara untuk memahami persoalan nyata.</p></div><div class="obs-practice-list">{activities.map(a=><a class="obs-practice" href={a.name==='Kegiatan'?'#kegiatan':'#karya'}><span class="obs-practice-number">{a.number}</span><Icon name={a.icon} size={32} /><h3>{a.name}</h3><p>{a.description}</p><Icon name="arrow" size={26} /></a>)}</div></div></section>

  <section class="wrap section obs-works" id="karya" data-project-gallery><div class="section-heading heading-split"><div><span class="eyebrow">03 / Register pekerjaan</span><h2>Yang kami telusuri.</h2></div><span class="small-note">Arsip ilustratif / 2025–2026</span></div><div class="work-filter filter-chips" role="group" aria-label="Filter portofolio">{['Semua','Proyek','Riset','Kegiatan'].map((t,i)=><button data-project-filter={t} aria-pressed={i===0}>{t}</button>)}<span class="result-count" aria-live="polite">6 pekerjaan contoh</span></div><div class="obs-work-grid">{projects.map(p=><article class="obs-work-card" data-project-card data-kind={p.kind}><button class="obs-art-link" data-open={`project-${p.id}`} aria-label={`Buka ${p.title}`}><ProjectArt kind={p.className} number={p.number} title={p.topic} /></button><div class="obs-work-copy"><div class="project-meta"><span>{p.kind}</span><span>{p.year} / {p.number}</span></div><button class="project-title" data-open={`project-${p.id}`}><h3>{p.title}</h3><Icon name="arrow" size={22} /></button><p>{p.place}</p></div></article>)}</div></section>

  <section class="obs-atlas-section section" id="peta"><div class="wrap"><div class="section-heading heading-split"><div><span class="eyebrow">04 / Atlas interaktif</span><h2>Mulai dari lokasinya.<br /><span class="soft-text">Temukan keterhubungannya.</span></h2></div><p>Enam titik contoh, setiap titik terhubung dengan sebuah pekerjaan dan catatan pengetahuan.</p></div><MapExplorer /><div class="map-section-caption"><span><Icon name="layers" size={15} />Sumber geometri: Natural Earth</span><span>Lokasi kota representatif · data contoh</span></div></div></section>

  <section class="wrap section obs-knowledge" id="pengetahuan"><div class="section-heading heading-split"><div><span class="eyebrow">05 / Pengetahuan terbuka</span><h2>Hasil yang bisa<br />ditelusuri kembali.</h2></div><p>Metode dicatat. Pertanyaan dibuka. Pengetahuan dibagikan melalui berbagai bentuk.</p></div><div class="obs-publications">{projects.slice(0,3).map(p=><button class="obs-publication" data-open={`publication-${p.id}`}><div class="obs-publication-head"><span class="tag">{p.format}</span><Icon name="arrow" size={23} /></div><div class="obs-publication-symbol"><Icon name={p.format==='Paper'?'paper':p.format==='Esai'?'book':'scan'} size={47} /><span>{p.number}</span></div><h3>{p.publication}</h3><p>{p.topic}</p><div class="obs-publication-foot"><span>{p.read} baca</span><span>Catatan contoh / 2026</span></div></button>)}</div></section>

  <section class="wrap obs-learning" id="kegiatan"><div class="obs-learning-mark"><span class="bkc-orbit"><i></i><i></i><i></i><i></i><i></i><i></i></span><img src="/bkc/assets/mark-squirrel-white.png" width="80" height="80" alt="" /></div><div><span class="eyebrow">06 / Forum pertanyaan</span><h2>Selalu ada yang<br />belum kita ketahui.</h2><p>Dan selalu ada kesempatan untuk mempelajarinya bersama. Temui perspektif baru melalui diskusi, kelas, dan kegiatan lapangan.</p></div><button class="button light" data-open="agenda">Temukan ruang belajar<Icon name="arrow" size={19} /></button></section>

  <section class="wrap section obs-collaborators"><Collaborators /></section>
  <section class="wrap obs-closing"><div class="obs-closing-label"><span class="eyebrow">Titik berikutnya</span><Icon name="crosshair" size={32} /></div><div><h2>Di mana kita<br /><span>mulai?</span></h2><div><p>Ceritakan wilayah, pertanyaan, atau gagasan yang ingin dijelajahi bersama BKC.</p><button class="button accent" data-open="collab">Mulai percakapan<Icon name="arrow" size={21} /></button></div></div></section>
</SiteLayout>
