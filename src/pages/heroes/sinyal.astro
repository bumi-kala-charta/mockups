---
import HeroLayout from '../../layouts/HeroLayout.astro';
import Icon from '../../components/Icon.astro';
import earth from '../../../public/heroes/sinyal-data.json';
import '../../styles/heroes/sinyal.css';

// A real, static first frame keeps the earth visible without JavaScript.
const mask = Uint8Array.from(atob(earth.mask), character => character.charCodeAt(0));
const columns = 112;
const rows = 56;
const tilt = 16 * Math.PI / 180;
const meridian = 110 * Math.PI / 180;
let staticEarth = '';
for (let row = 0; row < rows; row++) {
  for (let column = 0; column < columns; column++) {
    const x = (column - (columns - 1) / 2) / (columns / 2 - 2);
    const y = ((rows - 1) / 2 - row) / (rows / 2 - 1);
    const radius = x * x + y * y;
    if (radius > 1) { staticEarth += ' '; continue; }
    const z = Math.sqrt(1 - radius);
    const latitude = Math.asin(y * Math.cos(tilt) + z * Math.sin(tilt)) * 180 / Math.PI;
    const longitude = (Math.atan2(x, z * Math.cos(tilt) - y * Math.sin(tilt)) + meridian) * 180 / Math.PI;
    const u = Math.floor((longitude + 540) % 360);
    const v = Math.min(179, Math.max(0, Math.floor(90 - latitude)));
    const index = v * 360 + u;
    const land = Boolean(mask[index >> 3] & (1 << (index % 8)));
    staticEarth += land ? (z > .7 ? '#' : z > .3 ? '+' : ':') : '.';
  }
  if (row !== rows - 1) staticEarth += '\n';
}
---
<HeroLayout title="Sinyal · Hero 03" variant="sinyal" description="Bumi dalam karakter. Eksplorasi hero BKC dengan globe ASCII yang bergerak dari geometri Natural Earth.">
  <section class="sinyal-hero" aria-labelledby="sinyal-title">
    <div class="h-wrap sinyal-topline">
      <span class="h-eyebrow"><span class="sinyal-status-dot"></span> Geodesi · Geomatika · Komunitas</span>
      <span class="h-eyebrow sinyal-edition">BANDUNG, INDONESIA / 03</span>
    </div>

    <div class="h-wrap sinyal-composition">
      <div class="sinyal-copy">
        <div class="sinyal-prompt" aria-hidden="true"><span>bumi</span><i>/</i><span>kala</span><i>/</i><span>charta</span><b></b></div>
        <h1 id="sinyal-title">Di balik data,<br /><span>ada cerita.</span></h1>
        <p>Di antara titik dan koordinat, ada cerita yang belum terbaca. Kami mempertemukan data, pengetahuan, dan manusia untuk memahaminya.</p>
        <div class="sinyal-actions">
          <a class="h-button h-button--accent" href="/observatorium/#peta">Jelajahi atlas BKC <Icon name="arrow" size={19} /></a>
          <a class="sinyal-text-link" href="/atlas/#tentang">Kenali BKC <Icon name="right" size={17} /></a>
        </div>
        <div class="sinyal-coordinate">
          <Icon name="crosshair" size={21} />
          <div><span>Bertolak dari Bandung</span><strong>6,9175° LS · 107,6191° BT</strong><small>Lokasi kota representatif · WGS 84</small></div>
        </div>
      </div>

      <figure class="sinyal-observation" aria-label="Globe bumi dari karakter ASCII, berputar perlahan. Bentuk daratan bersumber dari Natural Earth.">
        <div class="sinyal-frame-heading"><span class="h-eyebrow">Bumi dalam karakter</span><span class="sinyal-record">GEO / 003</span></div>
        <div class="sinyal-sphere" data-sinyal-globe data-frame="0" data-motion-state="static">
          <pre class="sinyal-static-earth" aria-hidden="true">{staticEarth}</pre>
          <canvas class="sinyal-earth-canvas" aria-hidden="true"></canvas>
          <span class="sinyal-pole sinyal-pole-n" aria-hidden="true">U</span>
          <span class="sinyal-pole sinyal-pole-s" aria-hidden="true">S</span>
          <span class="sinyal-reticle sinyal-reticle-left" aria-hidden="true"><Icon name="plus" size={16} /></span>
          <span class="sinyal-reticle sinyal-reticle-right" aria-hidden="true"><Icon name="plus" size={16} /></span>
        </div>
        <figcaption class="sinyal-caption"><span><span class="sinyal-status-dot"></span><span data-sinyal-status>Perspektif statis</span></span><span>Natural Earth / Representasi artistik</span></figcaption>
      </figure>
    </div>

    <div class="h-wrap sinyal-bottomline">
      <div class="sinyal-bottom-intro"><span class="h-eyebrow">Cara kami membaca dunia</span><span>Dari pengamatan menjadi pemahaman.</span></div>
      <a href="/atlas/#karya"><span class="sinyal-index">01</span><span>Petakan<br /><small>Proyek & survei</small></span><Icon name="arrow" size={19} /></a>
      <a href="/observatorium/#pengetahuan"><span class="sinyal-index">02</span><span>Pelajari<br /><small>Riset & pengetahuan</small></span><Icon name="arrow" size={19} /></a>
      <a href="/ruang/#kegiatan"><span class="sinyal-index">03</span><span>Temukan<br /><small>Kelas & komunitas</small></span><Icon name="arrow" size={19} /></a>
    </div>
  </section>
  <script>import '../../scripts/heroes/sinyal';</script>
</HeroLayout>
