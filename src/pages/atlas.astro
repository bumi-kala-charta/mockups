---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectArt from '../components/ProjectArt.astro';
import MapExplorer from '../components/MapExplorer.astro';
import Collaborators from '../components/Collaborators.astro';
import { projects, activities, values } from '../data/demo';
import '../styles/atlas.css';
---
<SiteLayout theme="atlas" title="Atlas · Eksplorasi 01">
  <section class="wrap atlas-hero" aria-labelledby="hero-title">
    <div class="atlas-hero-copy">
      <span class="eyebrow"><Icon name="compass" size={16} />Geodesi, geomatika & ruang bersama</span>
      <h1 id="hero-title">Bumi punya<br />banyak <span>cerita.</span></h1>
      <p>Kami memetakannya, mempelajarinya, lalu membagikan pengetahuannya. Dari satu titik di lapangan, untuk pemahaman yang lebih luas.</p>
      <div class="hero-actions"><a class="button" href="#peta">Jelajahi jejak kami<Icon name="arrow" size={19} /></a><a class="text-link" href="#tentang">Kenali BKC<Icon name="right" size={17} /></a></div>
      <div class="atlas-origin"><span class="origin-mark"><img src="/bkc/assets/mark-squirrel-green.png" alt="" width="27" height="27" /></span><div>Berangkat dari Bandung.<br /><span>Terhubung dengan banyak sudut pandang.</span></div></div>
    </div>
    <div class="atlas-terrain">
      <span class="bkc-contour bkc-contour--ridge"></span>
      <div class="terrain-top"><span class="eyebrow">BUMI KALA CHARTA<br />CATATAN TENTANG BUMI</span><Icon name="north" size={34} /></div>
      <div class="terrain-axis"><span>107° 36′ BT</span><span>6° 55′ LS</span></div>
      <div class="terrain-focus"><Icon name="crosshair" size={52} /><span>Titik berangkat.<br />Bandung, Indonesia.</span></div>
      <div class="terrain-bottom"><span>01 / RUANG EKSPLORASI</span><span>WGS 84</span></div>
      <a href="#karya" class="terrain-note"><div class="note-icon"><Icon name="layers" size={25} /></div><div><span class="eyebrow">Di balik setiap peta</span><strong>Ada cerita yang layak dibagikan.</strong></div><Icon name="arrow" size={21} /></a>
    </div>
  </section>

  <div class="wrap atlas-intro-rule"><span>Memetakan ruang. Mempertemukan pengetahuan.</span><a href="#tentang" aria-label="Gulir ke tentang BKC"><Icon name="down" size={21} /></a><span class="eyebrow">BANDUNG · INDONESIA</span></div>

  <section class="wrap section atlas-about" id="tentang">
    <div class="section-side"><span class="eyebrow">01 / Tentang BKC</span><span class="side-line"></span></div>
    <div><h2>Kami percaya, memahami bumi <br />dimulai dengan <span class="green-text">rasa ingin tahu.</span></h2><div class="about-columns"><p>Bumi Kala Charta adalah ruang bertemu bagi mahasiswa, praktisi, dan kolaborator di bidang geodesi dan geomatika. Kami mengerjakan proyek, membuka pertanyaan riset, dan belajar dari pengalaman di lapangan.</p><div><p>Pengetahuan tumbuh saat dibagikan. Karena itu, setiap proses kami upayakan menjadi catatan yang bisa dipelajari kembali.</p><a class="text-link" href="/atlas/tentang/">Baca cerita BKC<Icon name="arrow" size={17} /></a></div></div></div>
  </section>

  <section class="wrap atlas-practices" aria-labelledby="practices-title">
    <div class="section-heading"><span class="eyebrow">Cara kami bergerak</span><h2 id="practices-title">Satu rasa ingin tahu.<br />Tiga ruang untuk bertumbuh.</h2></div>
    <div class="practice-grid">{activities.map(a=><article class="practice-card"><div class="practice-top"><Icon name={a.icon} size={29} /><span class="eyebrow">{a.number}</span></div><h3>{a.name}</h3><p>{a.description}</p><div class="practice-tags">{a.tags.map(t=><span>{t}</span>)}</div><a href={a.name === 'Kegiatan' ? '#kegiatan' : '#karya'} class="text-link" data-project-filter-jump={a.name === 'Kegiatan' ? undefined : a.name}>Jelajahi {a.name.toLowerCase()}<Icon name="arrow" size={17} /></a></article>)}</div>
  </section>

  <section class="section atlas-work" id="karya">
    <div class="wrap" data-project-gallery>
      <div class="section-heading heading-split"><div><span class="eyebrow">02 / Jejak pekerjaan</span><h2>Dari lapangan,<br />menjadi pemahaman.</h2></div><div><p>Pilihan cerita tentang ruang, data, dan orang-orang yang terhubung dengannya.</p><span class="small-note">Pilihan pekerjaan ilustratif</span></div></div>
      <div class="work-filter filter-chips" role="group" aria-label="Filter portofolio">{['Semua','Proyek','Riset','Kegiatan'].map((t,i)=><button data-project-filter={t} aria-pressed={i===0}>{t}</button>)}<span class="result-count" aria-live="polite">6 pekerjaan contoh</span></div>
      <div class="atlas-project-grid">{projects.map((p,i)=><article class:list={['project-card', {'featured': i===0}]} data-project-card data-kind={p.kind}><button class="project-image-button" data-open={`project-${p.id}`} aria-label={`Buka ${p.title}`}><ProjectArt kind={p.className} number={p.number} title={p.topic} /></button><div class="project-meta"><span>{p.kind} / {p.year}</span><span>{p.place.split(',')[0]}</span></div><button class="project-title" data-open={`project-${p.id}`}><h3>{p.title}</h3><Icon name="arrow" size={22} /></button><p>{p.description}</p></article>)}</div>
    </div>
  </section>

  <section class="wrap section atlas-map-section" id="peta"><div class="section-heading heading-split"><div><span class="eyebrow">03 / Jelajahi wilayah</span><h2>Setiap titik membuka<br />cerita yang berbeda.</h2></div><p>Pilih sebuah lokasi. Temukan pekerjaan, proses, dan pengetahuan yang tumbuh darinya.</p></div><MapExplorer /><div class="map-section-caption"><span><Icon name="crosshair" size={15} />Enam lokasi untuk menjelajahi pengalaman peta.</span><span>Data ilustratif · bukan sebaran pekerjaan resmi</span></div></section>

  <section class="atlas-knowledge section" id="pengetahuan"><div class="wrap"><div class="section-heading heading-split"><div><span class="eyebrow">04 / Pustaka pengetahuan</span><h2>Temuan tidak berhenti<br />di dalam sebuah folder.</h2></div><p>Catatan untuk dibaca, dipertanyakan, dan dikembangkan bersama.</p></div><div class="publication-list">{projects.slice(0,3).map(p=><button class="publication-row" data-open={`publication-${p.id}`}><span class="publication-index">{p.number}</span><div class="publication-row-title"><span class="eyebrow">{p.format} · {p.topic}</span><h3>{p.publication}</h3></div><span class="reading-time">{p.read} baca</span><span class="circle-link"><Icon name="arrow" size={22} /></span></button>)}</div></div></section>

  <section class="wrap section atlas-community" id="kegiatan"><div class="community-card"><span class="bkc-contour" data-pattern-density="loose"></span><span class="eyebrow">Ruang belajar</span><h2>Pertanyaan yang baik<br />layak dibicarakan<br />bersama.</h2><button class="button light" data-open="agenda">Lihat ruang diskusi<Icon name="arrow" size={18} /></button><span class="community-footnote">Diskusi terbuka · Kelas lapangan · Berbagi metode</span></div><div class="community-copy"><span class="eyebrow">Bertukar perspektif</span><h2>Datang dengan<br />rasa ingin tahu.</h2><p>Tidak harus sudah menguasai semuanya. Kami menyediakan ruang untuk bertanya, mencoba, dan belajar dari pengalaman satu sama lain.</p>{values.map((v,i)=><div class="value-line"><span>0{i+1}</span><div><h3>{v.title}</h3><p>{v.description}</p></div></div>)}<small class="small-note">Rumusan nilai untuk eksplorasi copy</small></div></section>

  <section class="wrap collaborators-section"><Collaborators /></section>
  <section class="wrap section atlas-cta"><span class="eyebrow">Punya pertanyaan tentang sebuah tempat?</span><div><h2>Mari membacanya<br /><span class="green-text">bersama.</span></h2><button class="button accent" data-open="collab">Mulai percakapan<Icon name="arrow" size={22} /></button></div></section>
</SiteLayout>
