---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../Icon.astro';
import ProfileHero from './ProfileHero.astro';
import { company, missions, companyValues, capabilities, workflow, milestones, team, partners, questions } from '../../data/company';
import '../../styles/company-profile.css';
interface Props { theme: 'atlas' | 'observatorium' | 'ruang' }
const { theme } = Astro.props;
const name = { atlas: 'Atlas', observatorium: 'Observatorium', ruang: 'Ruang' }[theme];
---
<SiteLayout theme={theme} page="profile" title={`Tentang BKC · ${name}`} description="Mengenal Bumi Kala Charta: cerita, visi, misi, nilai, bidang kerja, dan orang-orang di balik ruang kolaborasi geospasial. Konten dummy untuk eksplorasi desain.">
  <ProfileHero theme={theme} />

  <section class="wrap profile-section profile-story" id="cerita" aria-labelledby="story-title">
    <div class="profile-side"><span class="eyebrow">01 / Cerita kami</span><img src="/bkc/assets/logo-emblem.png" width="96" height="96" alt="Emblem Bumi Kala Charta" /><span class="small-note">Bumi. Kala. Charta.<br />Ruang, waktu, dan pemahaman.</span></div>
    <div class="profile-story-body"><h2 id="story-title">Berangkat dari rasa ingin tahu.<br />{' '}<span class="profile-accent">Bergerak untuk memberi arti.</span></h2><p class="profile-lead">{company.introduction}</p><div class="profile-prose"><p>{company.story}</p><p>{company.belief}</p></div><dl class="profile-facts">{company.facts.map(f => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl><p class="profile-dummy-note">Profil, tahun perjalanan, susunan tim, dan kontak pada halaman ini merupakan konten dummy untuk eksplorasi.</p></div>
  </section>

  <section class="profile-purpose" id="visi-misi" aria-labelledby="vision-title"><div class="wrap profile-purpose-inner">
    <div class="profile-vision"><span class="eyebrow">02 / Arah yang kami tuju</span><div class="profile-vision-label"><Icon name="north" size={42} /><h2 id="vision-title">Visi kami.</h2></div><p>{company.vision}</p><span class="profile-vision-foot">ILMU YANG TELITI. MANFAAT YANG BERARTI.</span></div>
    <div class="profile-mission"><span class="eyebrow">Langkah untuk mewujudkannya</span><h2>Misi kami.</h2><ol>{missions.map((m, i) => <li><span class="profile-number">0{i + 1}</span><div><h3>{m.title}</h3><p>{m.description}</p></div></li>)}</ol></div>
  </div></section>

  <section class="wrap profile-section profile-values" id="nilai" aria-labelledby="values-title"><div class="profile-heading"><div><span class="eyebrow">03 / Nilai yang kami pegang</span><h2 id="values-title">Cara berpikir.<br /><span class="profile-accent">Cara kami bekerja.</span></h2></div><p>Nilai tidak berhenti sebagai kata-kata. Ia hadir dalam keputusan kecil, percakapan, dan proses sehari-hari.</p></div><div class="profile-value-grid">{companyValues.map((v, i) => <article class="profile-value"><div class="profile-value-top"><Icon name={v.icon} size={28} /><span class="eyebrow">0{i + 1}</span></div><h3>{v.title}</h3><p>{v.description}</p><div class="profile-value-practice"><span class="eyebrow">Dalam praktik</span><p>{v.practice}</p></div></article>)}</div></section>

  <section class="profile-capabilities" id="bidang" aria-labelledby="capabilities-title"><div class="wrap profile-section"><div class="profile-heading"><div><span class="eyebrow">04 / Bidang kerja</span><h2 id="capabilities-title">Dari pertanyaan,<br />menjadi pemahaman.</h2></div><p>Tiga bidang yang saling melengkapi. Dari kebutuhan teknis hingga ruang untuk belajar bersama.</p></div><div class="profile-capability-grid">{capabilities.map(c => <article class="profile-capability"><div class="profile-capability-top"><span class="profile-number">{c.number}</span><Icon name={c.icon} size={31} /></div><h3>{c.title}</h3><p>{c.description}</p><div class="practice-tags">{c.tags.map(tag => <span>{tag}</span>)}</div><div class="profile-output"><span class="eyebrow">Contoh keluaran</span><p>{c.output}</p></div></article>)}</div><a href={`/${theme}/#karya`} class="text-link profile-work-link">Jelajahi contoh pekerjaan kami<Icon name="arrow" size={18} /></a></div></section>

  <section class="wrap profile-section profile-method" aria-labelledby="method-title"><div class="profile-heading"><div><span class="eyebrow">Dari awal sampai dibagikan</span><h2 id="method-title">Proses yang saling terbuka.</h2></div><p>Lingkup yang jelas, komunikasi yang terjaga, dan hasil yang bisa ditelusuri kembali.</p></div><ol class="profile-workflow">{workflow.map((w, i) => <li><div><span class="profile-step">0{i + 1}</span><Icon name="right" size={20} /></div><h3>{w.title}</h3><p>{w.description}</p></li>)}</ol></section>

  <section class="profile-journey" id="perjalanan" aria-labelledby="journey-title"><div class="wrap profile-section"><div class="profile-heading"><div><span class="eyebrow">05 / Perjalanan kami</span><h2 id="journey-title">Tumbuh, satu langkah<br /><span class="profile-accent">demi satu langkah.</span></h2></div><p>Setiap pertemuan menambahkan sesuatu pada cara kami melihat bumi.<small class="profile-dummy-note">Linimasa ilustratif · bukan sejarah resmi BKC.</small></p></div><ol class="profile-timeline">{milestones.map(m => <li><span class="profile-year">{m.year}</span><div><h3>{m.title}</h3><p>{m.description}</p></div></li>)}</ol></div></section>

  <section class="wrap profile-section profile-team" id="tim" aria-labelledby="team-title"><div class="profile-heading"><div><span class="eyebrow">06 / Orang-orang di balik proses</span><h2 id="team-title">Berbeda keahlian.<br /><span class="profile-accent">Saling melengkapi.</span></h2></div><p>Kami bekerja lintas peran, mempertemukan ketelitian teknis dengan kemampuan mendengar dan bercerita.</p></div><div class="profile-team-grid">{team.map(t => <article class="profile-team-card"><div class="profile-team-art" aria-hidden="true"><span class="bkc-contour" data-pattern-density="loose"></span><Icon name={t.icon} size={45} /><span>{t.number} / BKC</span></div><span class="eyebrow">{t.role}</span><h3>{t.title}</h3><p>{t.description}</p></article>)}</div><p class="profile-dummy-note">Susunan peran contoh. Nama dan profil anggota akan mengikuti informasi tim BKC.</p></section>

  <section class="wrap profile-partners" aria-labelledby="partners-title"><div><span class="eyebrow">Ruang kolaborasi</span><h2 id="partners-title">Pemahaman yang lebih luas<br />butuh banyak perspektif.</h2></div><div><p>Kami membuka ruang bagi rekan yang ingin menghubungkan pengetahuan dengan kebutuhan nyata.</p><ul>{partners.map(p => <li><Icon name="plus" size={16} />{p}</li>)}</ul><span class="profile-dummy-note">Kategori mitra ilustratif.</span></div></section>

  <section class="wrap profile-section profile-faq" aria-labelledby="faq-title"><div><span class="eyebrow">Sebelum memulai</span><h2 id="faq-title">Mungkin ini<br />{' '}yang ingin ditanyakan.</h2></div><div class="profile-faq-list">{questions.map(q => <details name="profile-faq"><summary>{q.question}<Icon name="plus" size={21} /></summary><p>{q.answer}</p></details>)}</div></section>

  <section class="profile-contact" id="kontak" aria-labelledby="contact-title"><div class="wrap"><span class="eyebrow">07 / Titik temu berikutnya</span><div class="profile-contact-main"><h2 id="contact-title">Ada gagasan?<br /><span>Mari mulai percakapan.</span></h2><div><p>Ceritakan tempat, pertanyaan, atau kemungkinan yang ingin dijelajahi bersama.</p><button class="button accent" data-open="collab">Bicarakan kolaborasi<Icon name="arrow" size={20} /></button></div></div><div class="profile-contact-details"><div><span class="eyebrow">Titik berangkat</span><p>Bandung, Jawa Barat<br />Indonesia</p></div><div><span class="eyebrow">Surel · contoh</span><p>halo@bkc.example</p><small>Alamat dummy, belum aktif.</small></div><div><span class="eyebrow">Ruang pertemuan</span><p>Daring atau tatap muka<br />Melalui janji temu</p></div><a class="text-link" href={`/${theme}/`}>Kembali ke beranda<Icon name="arrow" size={18} /></a></div></div></section>
</SiteLayout>
